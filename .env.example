# Loaded automatically on local runs (loadDotEnv). Real environment always wins,
# so GitHub Actions secrets are unaffected by this file.

# Notifications — set at least one
# Telegram (recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional)
# Option A: SMTP (sent via nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_FROM=
# Option B: Resend API
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# AI (optional) — semantic reranking + explanations for top jobs
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AI_HEAVY=true

# Behavior
# hunt = discover only, report = digest only, full = hunt+report (default)
MODE=full
# true = actually suppress ALL notifications (instant alerts, reports, digests)
DRY_RUN=false
# Overrides data/config.json instantAlertThreshold (watchlist jobs alert at threshold - 5)
INSTANT_ALERT_THRESHOLD=
# true = skip python-jobspy sources without uninstalling anything
JOBSPY_DISABLED=
