# Notifications — set at least one
# Telegram (recommended)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (optional, via SMTP or Resend)
# Option A: SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
EMAIL_FROM=

# Option B: Resend API
RESEND_API_KEY=
RESEND_FROM=
RESEND_TO=

# AI (optional) — for explanation reranking
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Behavior
# hunt = discover only, report = digest only, full = hunt+report (default)
MODE=full
DRY_RUN=false
INSTANT_ALERT_THRESHOLD=85
