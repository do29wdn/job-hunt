{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "description": "Personal job-hunting radar — GitHub Actions + TypeScript",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "hunt": "tsx src/index.ts --mode=hunt",
    "report": "tsx src/index.ts --mode=report",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "open-linkedin-jobs": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  }
}
